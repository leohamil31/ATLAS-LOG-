{
  "$description": "ATLAS LOG design tokens — fonte da verdade: lib/core/theme.dart (AtlasColors, AtlasRadius, AtlasMotion, AtlasBreakpoints, AtlasLight). Cores com 8 dígitos = #RRGGBBAA.",
  "color": {
    "light": {
      "bg": "#F3F6F9",
      "surface": "#FFFFFF",
      "card": "#FFFFFF",
      "border": "#E1E8EF",
      "text": "#0E1E33",
      "muted": "#5A6B80",
      "accent": "#0E5A9C",
      "accent2": "#1F6FA8",
      "accent3": "#2BB3B1",
      "success": "#0F8A5F",
      "warning": "#B45309",
      "danger": "#C0262D",
      "glass": "#FFFFFFC7",
      "shadow": "#0E3A6B"
    },
    "dark": {
      "bg": "#06111E",
      "surface": "#0C1C2E",
      "card": "#0F2236",
      "border": "#1C3550",
      "text": "#EEF4FA",
      "muted": "#8FA6BF",
      "accent": "#6FD3CB",
      "accent2": "#2B7BC0",
      "accent3": "#2BB3B1",
      "success": "#34D399",
      "warning": "#FBBF24",
      "danger": "#F87171",
      "glass": "#0F2236A6",
      "shadow": "#000000"
    }
  },
  "gradient": {
    "brand": "linear-gradient(135deg, accent2, accent3)",
    "sheen": "linear-gradient(180deg, rgba(255,255,255,.34) 0%, rgba(255,255,255,0) 55%)"
  },
  "radius": {
    "xs": 6,
    "sm": 10,
    "md": 14,
    "lg": 18,
    "xl": 24,
    "pill": 999
  },
  "motion": {
    "duration_ms": {
      "instant": 90,
      "fast": 150,
      "base": 240,
      "slow": 380,
      "entrance": 460
    },
    "easing": {
      "enter": "cubic-bezier(0.05, 0.7, 0.1, 1)",
      "exit": "cubic-bezier(0.3, 0, 0.8, 0.15)",
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "pop": "easeOutBack"
    }
  },
  "breakpoints": {
    "phone": 600,
    "tablet": 940,
    "desktop": 1100,
    "contentMax": 1480
  },
  "light": {
    "direction": "top-left",
    "edge": "base darkened 38%",
    "volume": "base +16% white → base → base −22% black (135deg)"
  },
  "typography": {
    "family": "Inter (google_fonts)",
    "headings": {
      "weight": 800,
      "letterSpacing": "-0.3 a -0.7"
    },
    "body": {
      "weight": 400
    }
  },
  "brand": {
    "navy": "#0E3A6B",
    "navyDeep": "#0A2A4F",
    "blue": "#1F6FA8",
    "teal": "#2BB3B1",
    "tealLight": "#5FD0C8",
    "tagline": "CONNECTING THE WORLD"
  },
  "glass": {
    "blur": "16-18px",
    "specular": "linear-gradient(180deg, rgba(255,255,255,.45) 0%, transparent 32%) — .10 no escuro",
    "border": "white .85 (claro) / .08 (escuro) + hairline border"
  }
}
